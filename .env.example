# Copy this file to .env and fill in your values

SECRET_KEY=your-very-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1

# Leave blank to use SQLite locally. Do not leave this blank in production.
# Railway: create one PostgreSQL service, then set this as a reference variable
# on the web service: ${{Postgres.DATABASE_URL}} (replace Postgres if renamed).
DATABASE_URL=
